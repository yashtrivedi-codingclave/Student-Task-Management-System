# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to GitHub.

PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Frontend URL(s) used for CORS — comma-separated if you need more than one
# On Render, set this to your Vercel URL (and optionally include localhost).
CLIENT_URL=https://student-task-management-system-sigma.vercel.app,http://localhost:5173
